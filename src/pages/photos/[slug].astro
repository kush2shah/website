---
import { render } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Photo from '../../components/Photo.astro';
import { getPhotoCollections, photoDetails, remoteAt, type PhotoCollection } from '../../lib/photos';
import { SITE } from '../../lib/site';

export async function getStaticPaths() {
    const collections = await getPhotoCollections();
    return collections.map((collection, i) => ({
        params: { slug: collection.id },
        props: {
            collection,
            prev: collections[(i - 1 + collections.length) % collections.length],
            next: collections[(i + 1) % collections.length],
        },
    }));
}

interface Props {
    collection: PhotoCollection;
    prev: PhotoCollection;
    next: PhotoCollection;
}

const { collection, prev, next } = Astro.props;
const { data, photos, cover, dateLabel, gear } = collection;
const { Content } = await render(collection.entry);

const facts = [
    gear.film.length > 0 && { label: 'Film', value: gear.film.join(', ') },
    gear.cameras.length > 0 && { label: gear.cameras.length > 1 ? 'Cameras' : 'Camera', value: gear.cameras.join(', ') },
    gear.lenses.length > 0 && { label: gear.lenses.length > 1 ? 'Lenses' : 'Lens', value: gear.lenses.join(', ') },
    data.place && { label: 'Place', value: data.place },
    { label: 'Date', value: dateLabel },
    { label: photos.every((p) => p.film) ? 'Frames' : 'Photos', value: String(photos.length) },
].filter((f): f is { label: string; value: string } => !!f);

// The lightbox opens a 2048px version rather than the original file.
const large = await Promise.all(
    photos.map(async (p) =>
        typeof p.src === 'string'
            ? remoteAt(p.src, 2048)
            : (await getImage({ src: p.src, width: Math.min(2048, p.src.width), format: 'webp' })).src,
    ),
);

const description = `${data.title}: ${[data.place, dateLabel].filter(Boolean).join(', ')}. Photography by Kush Shah.`;
const note = data.note?.replace(SITE.email, `<a href="mailto:${SITE.email}">${SITE.email}</a>`);
---

<Base title={data.title} description={description} image={typeof cover.src === 'string' ? undefined : cover.src}>
    <header class="wrap head">
        <a class="back arrow-link" href="/photos/"><Icon name="chevron-left" /> Photos</a>
        <h1 class="page-title">{data.title}</h1>
        <div class="lede intro"><Content /></div>
        <dl class="facts">
            {
                facts.map((f) => (
                    <div>
                        <dt class="eyebrow">{f.label}</dt>
                        <dd>{f.value}</dd>
                    </div>
                ))
            }
        </dl>
        {note && <p class="note" set:html={note} />}
    </header>

    <photo-lightbox>
        <div class="grid">
            {
                photos.map((p, i) => {
                    const href = large[i];
                    const details = [p.caption, photoDetails(p)].filter(Boolean).join(' — ');
                    return (
                        <a class="tile" href={href} data-index={i} data-caption={details}>
                            <Photo photo={p} sizes="(max-width: 800px) 100vw, 33vw" widths={[400, 800, 1200]} loading={i < 3 ? 'eager' : 'lazy'} />
                            {p.caption && <span class="tile-caption">{p.caption}</span>}
                        </a>
                    );
                })
            }
        </div>
        <dialog aria-label={data.title}>
            <button type="button" class="close" aria-label="Close"><Icon name="close" size={16} /></button>
            <button type="button" class="step prev" aria-label="Previous photo"><Icon name="chevron-left" size={20} /></button>
            <figure>
                <img alt="" />
                <p class="failed" role="alert">
                    This photo didn't load. <button type="button" class="retry">Try again</button>
                </p>
                <figcaption></figcaption>
            </figure>
            <span class="spinner" aria-hidden="true"></span>
            <button type="button" class="step next" aria-label="Next photo"><Icon name="chevron-right" size={20} /></button>
        </dialog>
    </photo-lightbox>

    <nav class="wrap more" aria-label="More collections">
        <a href={`/photos/${prev.id}/`}>
            <span class="eyebrow">Previous</span>
            <span class="more-title">{prev.data.title}</span>
        </a>
        <a class="right" href={`/photos/${next.id}/`}>
            <span class="eyebrow">Next</span>
            <span class="more-title">{next.data.title}</span>
        </a>
    </nav>
</Base>

<script>
    // Click a photo to view it large. Without JS, the link opens the full image.
    //
    // A photo only replaces the one on screen once it has loaded, so the caption never
    // describes the wrong picture. Neighbours load ahead so stepping through is instant.
    class PhotoLightbox extends HTMLElement {
        connectedCallback() {
            const tiles = [...this.querySelectorAll<HTMLAnchorElement>('a.tile')];
            const dialog = this.querySelector('dialog');
            const img = dialog?.querySelector<HTMLImageElement>('figure img');
            const caption = dialog?.querySelector('figcaption');
            if (!dialog || !img || !caption) return;
            const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
            let index = 0;
            // Bumped on every step and on close, so a slow photo can't land after a newer one.
            let latest = 0;

            const load = (src: string) =>
                new Promise<void>((resolve, reject) => {
                    const image = new Image();
                    image.onload = () => image.decode().catch(() => {}).then(resolve);
                    image.onerror = reject;
                    image.src = src;
                });
            const at = (i: number) => tiles[(i + tiles.length) % tiles.length];

            // Photos slide a little in the direction of travel; with reduced motion they only fade.
            const offset = (px: number) => (reduceMotion.matches || px === 0 ? 'none' : `translateX(${px}px)`);
            const leave = (dir: number) =>
                img.getAttribute('src')
                    ? img.animate([{ opacity: 0, transform: offset(dir * -24) }], { duration: 160, easing: 'ease-in', fill: 'forwards' })
                          .finished.catch(() => {})
                    : Promise.resolve();
            const enter = (dir: number) => {
                img.getAnimations().forEach((a) => a.cancel());
                img.animate([{ opacity: 0, transform: offset(dir * 24) }, { opacity: 1, transform: 'none' }], {
                    duration: reduceMotion.matches ? 120 : 260,
                    easing: 'cubic-bezier(0, 0, 0.2, 1)',
                });
            };

            const show = async (i: number, dir = 0) => {
                index = (i + tiles.length) % tiles.length;
                const step = ++latest;
                const tile = at(index);
                dialog.dataset.state = 'loading';
                const [loaded] = await Promise.all([load(tile.href).then(() => true, () => false), leave(dir)]);
                if (step !== latest) return;

                caption.textContent = tile.dataset.caption ?? '';
                if (!loaded) {
                    dialog.dataset.state = 'failed';
                    return;
                }
                img.src = tile.href;
                img.alt = tile.querySelector('img')?.alt ?? '';
                dialog.dataset.state = 'ready';
                enter(dir);
                for (const n of [index + 1, index - 1]) load(at(n).href).catch(() => {});
            };

            tiles.forEach((tile, i) => {
                // Start loading on hover so the first open is usually instant.
                tile.addEventListener('pointerenter', () => load(tile.href).catch(() => {}), { once: true });
                tile.addEventListener('click', (e) => {
                    e.preventDefault();
                    img.getAnimations().forEach((a) => a.cancel());
                    img.removeAttribute('src');
                    caption.textContent = '';
                    dialog.showModal();
                    show(i);
                });
            });
            dialog.addEventListener('close', () => latest++);
            dialog.querySelector('.close')?.addEventListener('click', () => dialog.close());
            dialog.querySelector('.prev')?.addEventListener('click', () => show(index - 1, -1));
            dialog.querySelector('.next')?.addEventListener('click', () => show(index + 1, 1));
            dialog.querySelector('.retry')?.addEventListener('click', () => show(index));
            dialog.addEventListener('click', (e) => {
                if (e.target === dialog) dialog.close();
            });
            dialog.addEventListener('keydown', (e) => {
                if (e.key === 'ArrowLeft') show(index - 1, -1);
                if (e.key === 'ArrowRight') show(index + 1, 1);
            });

            // Swipe between photos on touch screens. Two-finger gestures are left to pinch-zoom.
            let start: { x: number; y: number } | undefined;
            dialog.addEventListener(
                'touchstart',
                (e) => (start = e.touches.length === 1 ? { x: e.touches[0].clientX, y: e.touches[0].clientY } : undefined),
                { passive: true },
            );
            dialog.addEventListener('touchend', (e) => {
                if (!start) return;
                const dx = e.changedTouches[0].clientX - start.x;
                const dy = e.changedTouches[0].clientY - start.y;
                start = undefined;
                if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) show(index + (dx < 0 ? 1 : -1), dx < 0 ? 1 : -1);
            });
        }
    }
    customElements.define('photo-lightbox', PhotoLightbox);
</script>

<style>
    .head {
        display: flex;
        flex-direction: column;
        gap: 20px;
        padding-block: 40px 40px;
    }
    .back {
        align-self: flex-start;
        color: var(--text-3);
    }
    .intro:empty {
        display: none;
    }
    .facts {
        display: flex;
        flex-wrap: wrap;
        gap: 16px 40px;
        margin-top: 8px;
        padding-block: 20px;
        border-block: 1px solid var(--border);
    }
    .facts div {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }
    dd {
        font-size: 15px;
    }
    .note {
        max-width: 640px;
        font-size: 15px;
        line-height: 1.75;
        color: var(--text-2);
    }
    .note :global(a) {
        color: var(--text);
        border-bottom: 1px solid var(--border-s);
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
        gap: 3px;
        padding-inline: 3px;
    }
    @media (max-width: 420px) {
        .grid {
            grid-template-columns: 1fr;
        }
    }
    .tile {
        position: relative;
        display: block;
        aspect-ratio: 3 / 2;
        overflow: hidden;
        background: var(--bg-hi);
        cursor: zoom-in;
    }
    .tile :global(picture),
    .tile :global(img) {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: opacity 500ms var(--ease), transform 600ms var(--ease-out), filter 400ms var(--ease);
    }
    .tile:hover :global(img) {
        transform: scale(1.03);
        filter: brightness(0.9);
    }
    .tile-caption {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        padding: 40px 16px 12px;
        background: linear-gradient(0deg, rgba(0, 0, 0, 0.55), transparent);
        color: #fff;
        font-size: 11px;
        font-weight: 400;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        opacity: 0;
        transition: opacity 300ms var(--ease);
    }
    .tile:hover .tile-caption,
    .tile:focus-visible .tile-caption {
        opacity: 1;
    }
    @media (hover: none) {
        .tile-caption {
            opacity: 1;
        }
    }

    dialog {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100dvh;
        max-width: none;
        max-height: none;
        margin: 0;
        padding: 0;
        border: none;
        /* Layout lives here rather than on [open], or the photo jumps aside while it fades out. */
        align-items: center;
        justify-content: center;
        background: rgba(8, 8, 8, 0.95);
        color: #fff;
        /* Fades in and out; display and overlay hold until the fade-out finishes. */
        opacity: 0;
        transition:
            opacity 260ms var(--ease),
            display 260ms allow-discrete,
            overlay 260ms allow-discrete;
    }
    dialog[open] {
        display: flex;
        opacity: 1;
    }
    dialog::backdrop {
        background: rgba(0, 0, 0, 0.6);
    }
    figure {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 14px;
        max-width: calc(100vw - 140px);
        transform: scale(0.97);
        transition: transform 320ms var(--ease-out);
    }
    dialog[open] figure {
        transform: none;
    }
    @starting-style {
        dialog[open] {
            opacity: 0;
        }
        dialog[open] figure {
            transform: scale(0.97);
        }
    }
    figure img {
        max-width: 100%;
        max-height: calc(100dvh - 120px);
        width: auto;
        object-fit: contain;
    }
    figcaption {
        font-family: var(--mono);
        font-size: 11px;
        line-height: 1.6;
        text-align: center;
        color: rgba(255, 255, 255, 0.78);
        transition: opacity 160ms var(--ease);
    }
    /* While the next photo loads, the caption steps out with the old one. */
    dialog[data-state='loading'] figcaption {
        opacity: 0;
    }

    /* Only shows if a photo takes more than a moment. */
    .spinner {
        position: absolute;
        inset: 0;
        width: 28px;
        height: 28px;
        margin: auto;
        border: 2px solid rgba(255, 255, 255, 0.18);
        border-top-color: rgba(255, 255, 255, 0.8);
        border-radius: 50%;
        opacity: 0;
        pointer-events: none;
        transition: opacity 200ms var(--ease);
        animation: spin 800ms linear infinite;
    }
    dialog[data-state='loading'] .spinner {
        opacity: 1;
        transition-delay: 300ms;
    }
    @keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .failed {
        display: none;
        font-size: 14px;
        color: rgba(255, 255, 255, 0.78);
    }
    dialog[data-state='failed'] .failed {
        display: block;
    }
    dialog[data-state='failed'] figure img {
        display: none;
    }
    .retry {
        padding: 0;
        border: none;
        border-bottom: 1px solid rgba(255, 255, 255, 0.4);
        background: none;
        color: #fff;
    }

    dialog > button {
        position: absolute;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        border: none;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.08);
        color: rgba(255, 255, 255, 0.8);
    }
    dialog > button:hover {
        background: rgba(255, 255, 255, 0.16);
        color: #fff;
    }
    .close {
        top: 16px;
        right: 16px;
    }
    .step {
        top: 50%;
        transform: translateY(-50%);
    }
    .step.prev {
        left: 16px;
    }
    .step.next {
        right: 16px;
    }
    @media (max-width: 640px) {
        figure {
            max-width: 100vw;
        }
        .step {
            top: auto;
            bottom: 16px;
            transform: none;
        }
    }

    .more {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 24px;
        padding-block: 72px 120px;
    }
    .more a {
        flex: 1 1 260px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding-block: 8px;
    }
    .more a.right {
        align-items: flex-end;
        text-align: right;
    }
    .more-title {
        font-size: 26px;
        font-weight: 200;
        letter-spacing: -0.01em;
    }
</style>
