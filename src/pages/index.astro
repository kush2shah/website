---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import PostList from '../components/PostList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PhotoStrip from '../components/PhotoStrip.astro';
import { getPhotoCollections } from '../lib/photos';
import { getPosts } from '../lib/site';

// The full-bleed photo on the landing page. Any local photo works.
const HERO = { collection: 'yosemite', file: 'tunnel-view.jpg' };

const collections = await getPhotoCollections();
const heroCollection = collections.find((c) => c.id === HERO.collection);
const hero = heroCollection?.photos.find((p) => p.file === HERO.file);
if (!heroCollection || !hero) throw new Error(`Hero photo not found: ${HERO.collection}/${HERO.file}`);
const heroCaption = [hero.caption ? `${hero.caption}, ${heroCollection.data.title}` : heroCollection.data.title, hero.camera, hero.lens]
    .filter(Boolean)
    .join(' · ');

const posts = (await getPosts()).slice(0, 3);
const projects = (await getCollection('projects'))
    .filter((p) => p.data.featured)
    .sort((a, b) => a.data.order - b.data.order)
    .slice(0, 3);
const stripCollections = collections.filter((c) => typeof c.cover.src !== 'string').slice(0, 10);
---

<Base nav="overlay" image={typeof hero.src === 'string' ? undefined : hero.src}>
    <section class="hero">
        <div class="hero-photo">
            <Photo photo={hero} sizes="100vw" widths={[800, 1280, 1920, 2560]} loading="eager" priority />
        </div>
        <div class="scrim" aria-hidden="true"></div>
        <div class="hero-text">
            <div class="intro">
                <h1>Kush Shah</h1>
                <p>Deployed Engineer at LangChain. I build apps, and I photograph the people and places around me.</p>
            </div>
            <div class="hero-meta">
                <a class="caption" href={`/photos/${heroCollection.id}/`}>{heroCaption}</a>
                <a class="scroll" href="#more">Scroll <Icon name="arrow-down" /></a>
            </div>
        </div>
    </section>

    <div id="more">
        {
            posts.length > 0 && (
                <section class="wrap block">
                    <div class="section-head">
                        <h2 class="eyebrow">Writing</h2>
                        <a class="arrow-link" href="/writing/">
                            All writing <Icon name="arrow-right" />
                        </a>
                    </div>
                    <PostList posts={posts} />
                </section>
            )
        }

        <section class="wrap block">
            <div class="section-head">
                <h2 class="eyebrow">Projects</h2>
                <a class="arrow-link" href="/projects/">All projects <Icon name="arrow-right" /></a>
            </div>
            <div class="projects">
                {projects.map((p) => <ProjectCard project={p} compact />)}
            </div>
        </section>

        <section class="block photos">
            <div class="wrap">
                <div class="section-head">
                    <h2 class="eyebrow">Photos</h2>
                    <a class="arrow-link" href="/photos/">All collections <Icon name="arrow-right" /></a>
                </div>
            </div>
            <PhotoStrip collections={stripCollections} label="Recent collections" />
        </section>
    </div>
</Base>

<style>
    .hero {
        position: relative;
        height: 100svh;
        min-height: 560px;
        overflow: hidden;
        background: #0b0a09;
        color: #fff;
    }
    .hero-photo,
    .hero-photo :global(picture),
    .hero-photo :global(img) {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .scrim {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            180deg,
            rgba(0, 0, 0, 0.45) 0%,
            rgba(0, 0, 0, 0) 22%,
            rgba(0, 0, 0, 0) 48%,
            rgba(0, 0, 0, 0.62) 100%
        );
    }
    .hero-text {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: 24px 40px;
        padding: 0 var(--gutter) 36px;
    }
    .intro {
        display: flex;
        flex-direction: column;
        gap: 16px;
        max-width: 760px;
    }
    h1 {
        font-size: clamp(64px, 11vw, 148px);
        font-weight: 200;
        letter-spacing: -0.04em;
        line-height: 0.9;
    }
    .intro p {
        max-width: 520px;
        font-size: 18px;
        line-height: 1.55;
        color: rgba(255, 255, 255, 0.9);
    }
    .hero-meta {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 6px;
    }
    .caption {
        padding-block: 6px;
        font-family: var(--mono);
        font-size: 11px;
        line-height: 1.6;
        text-align: right;
        color: rgba(255, 255, 255, 0.85);
    }
    .caption:hover {
        color: #fff;
    }
    .scroll {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding-block: 12px;
        font-size: 11px;
        font-weight: 400;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.88);
    }
    @media (max-width: 640px) {
        .hero-meta {
            align-items: flex-start;
        }
        .caption {
            text-align: left;
        }
    }

    .block {
        padding-top: 96px;
    }
    .photos {
        padding-bottom: 120px;
    }
    .photos .section-head {
        margin-bottom: 24px;
    }
    .projects {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 0 40px;
    }
</style>
