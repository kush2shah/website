---
import { render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import headshot from '../../assets/about/headshot.jpeg';
import { formatDate, getPosts } from '../../lib/site';

export async function getStaticPaths() {
    const posts = await getPosts();
    return posts.map((post, i) => ({
        params: { slug: post.id },
        props: { post, newer: posts[i - 1], older: posts[i + 1] },
    }));
}

interface Props {
    post: CollectionEntry<'writing'>;
    newer?: CollectionEntry<'writing'>;
    older?: CollectionEntry<'writing'>;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const minutes = Math.max(1, Math.round((post.body ?? '').split(/\s+/).filter(Boolean).length / 230));
---

<Base title={post.data.title} description={post.data.description} type="article">
    <article class="wrap-narrow page">
        <a class="back arrow-link" href="/writing/"><Icon name="chevron-left" /> Writing</a>
        <header class="head">
            <h1>{post.data.title}</h1>
            <p class="dek">{post.data.description}</p>
            <p class="eyebrow">
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time> · {minutes} min read
            </p>
        </header>
        <div class="prose body">
            <Content />
        </div>

        <aside class="byline">
            <Image src={headshot} alt="" width={48} height={48} densities={[1, 2]} class="avatar" />
            <div>
                <a href="/about/" class="name">Kush Shah</a>
                <p>Deployed Engineer at LangChain.</p>
            </div>
            <a class="arrow-link" href="/rss.xml"><Icon name="rss" size={12} /> RSS</a>
        </aside>

        {
            (older || newer) && (
                <nav class="more" aria-label="More writing">
                    {older ? (
                        <a href={`/writing/${older.id}/`}>
                            <span class="eyebrow">Previous</span>
                            <span class="more-title">{older.data.title}</span>
                        </a>
                    ) : (
                        <span />
                    )}
                    {newer && (
                        <a class="right" href={`/writing/${newer.id}/`}>
                            <span class="eyebrow">Next</span>
                            <span class="more-title">{newer.data.title}</span>
                        </a>
                    )}
                </nav>
            )
        }
    </article>
</Base>

<style>
    .page {
        padding-block: 40px 120px;
    }
    .back {
        color: var(--text-3);
    }
    .head {
        display: flex;
        flex-direction: column;
        gap: 18px;
        margin-top: 24px;
        padding-bottom: 36px;
        border-bottom: 1px solid var(--border);
    }
    h1 {
        font-size: clamp(36px, 5vw, 48px);
        font-weight: 200;
        letter-spacing: -0.02em;
        line-height: 1.12;
    }
    .dek {
        font-size: 20px;
        line-height: 1.6;
        color: var(--text-2);
    }
    .body {
        padding-top: 36px;
        font-size: 18px;
    }
    .byline {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 20px;
        margin-top: 72px;
        padding-block: 28px;
        border-block: 1px solid var(--border);
    }
    .byline > div {
        flex: 1 1 240px;
    }
    .byline :global(.avatar) {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        object-fit: cover;
        object-position: center top;
    }
    .name {
        font-size: 15px;
        font-weight: 400;
    }
    .byline p {
        font-size: 14px;
        color: var(--text-2);
    }
    .more {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 24px;
        padding-top: 36px;
    }
    .more a {
        flex: 1 1 260px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
    .more a.right {
        align-items: flex-end;
        text-align: right;
    }
    .more-title {
        font-size: 18px;
        line-height: 1.4;
    }
</style>
