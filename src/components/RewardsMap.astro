<script is:inline>
'use strict';
const DATA=JSON.parse(document.getElementById('data').textContent),NS='http://www.w3.org/2000/svg',nodes=new Map(DATA.nodes.map(n=>[n.id,n]));
const palette={transfer:'#5ee6b5',earn:'#7cb9ff',benefit:'#e9c77e',bridge:'#b7a0f6',cobrand:'#eb9cca'},typeNames={transfer:'Points transfer',earn:'Earn / rewards payout',benefit:'Benefit / linked offer',bridge:'Shared currency bridge',cobrand:'Co-branded earning'},catNames={bank:'CARD CURRENCIES',airline:'AIRLINE PROGRAMS',hotel:'HOTEL PROGRAMS',business:'EVERYDAY BUSINESSES',program:'OTHER PROGRAMS',card:'SELECTED CARDS'},catColor={bank:'#5ee6b5',airline:'#7cb9ff',hotel:'#b7a0f6',business:'#e9c77e',program:'#b7a0f6',card:'#eb9cca'};
let view='overview',focus=window.matchMedia('(max-width:700px)').matches?'chase':'',filter='',enabled=new Set(Object.keys(palette)),visibleNodes=[],visibleEdges=[],positions=new Map(),vb={x:0,y:0,w:2160,h:1250};
const svg=document.getElementById('graph'),detail=document.getElementById('details'),esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const core=new Set('chase amex citi capone bilt wf united delta aa atmos aeroplan flyingblue ba virgin marriott hilton hyatt choice accor uber lyft rakuten starbucks doordash mgm csr platinum'.split(' '));
document.getElementById('stats').innerHTML=`<span><strong>${DATA.nodes.length}</strong> nodes &nbsp; / &nbsp; <strong>${DATA.edges.length}</strong> relationships</span><br>US ecosystem · original snapshot ${DATA.date}`;
const select=document.getElementById('focus');DATA.nodes.slice().sort((a,b)=>a.name.localeCompare(b.name)).forEach(n=>{let o=document.createElement('option');o.value=n.id;o.textContent=n.name+' · '+n.sub;select.appendChild(o)});
Object.keys(palette).forEach(t=>{let l=document.createElement('label');l.innerHTML=`<input type="checkbox" checked data-type="${t}"><span class="swatch" style="border-color:${palette[t]};${t==='benefit'?'border-top-style:dashed':''}"></span>${typeNames[t]}`;document.getElementById('legend').append(l)});
document.getElementById('sources').innerHTML=Object.values(DATA.sources).map(s=>`<div><a href="${esc(s.url)}" target="_blank" rel="noopener">${esc(s.title)}</a>${s.primary?'':' <span>SECONDARY CROSS-CHECK</span>'}</div>`).join('');
function el(tag,attrs={},text){let e=document.createElementNS(NS,tag);Object.entries(attrs).forEach(([k,v])=>e.setAttribute(k,v));if(text!==undefined)e.textContent=text;return e}
function getGraph(){let edges=DATA.edges.filter(e=>enabled.has(e.type));if(focus)edges=edges.filter(e=>e.a===focus||e.b===focus);else if(view==='overview')edges=edges.filter(e=>core.has(e.a)&&core.has(e.b));else if(view==='transfer')edges=edges.filter(e=>['transfer','bridge'].includes(e.type));else if(view==='everyday')edges=edges.filter(e=>['earn','benefit'].includes(e.type)&& (nodes.get(e.a).cat==='business'||nodes.get(e.b).cat==='business'||['csr','platinum'].includes(e.a)));else if(view==='cards')edges=edges.filter(e=>e.type==='cobrand'||['csr','platinum'].includes(e.a));
if(filter){let matches=new Set(DATA.nodes.filter(n=>(n.name+' '+n.sub).toLowerCase().includes(filter)).map(n=>n.id));edges=edges.filter(e=>matches.has(e.a)||matches.has(e.b))}let ids=new Set(edges.flatMap(e=>[e.a,e.b]));if(focus)ids.add(focus);return{edges,ns:DATA.nodes.filter(n=>ids.has(n.id))}}
function layout(ns){positions=new Map();if(window.matchMedia('(max-width:700px)').matches&&!document.querySelector('.rewards-map').classList.contains('mobile-full')){let list=ns.filter(n=>n.id!==focus);if(focus){positions.set(focus,{x:310,y:115})}list.forEach((n,i)=>positions.set(n.id,{x:i%2?460:160,y:(focus?255:145)+Math.floor(i/2)*105}));return{height:Math.max(700,...[...positions.values()].map(p=>p.y+100)),airlineCols:1,mobile:true}};let categories={bank:[],airline:[],hotel:[],business:[],program:[],card:[]};ns.forEach(n=>categories[n.cat].push(n));let counts=Object.fromEntries(Object.entries(categories).map(([k,v])=>[k,v.length]));let crowded=ns.length>37;let height=Math.max(1150,Math.ceil(counts.airline/(crowded?2:1))*90+210,counts.hotel*100+180,counts.business*105+180);let airlineCols=crowded?2:1;let spots={bank:200,airline:airlineCols===2?720:880,hotel:1410,business:1880,program:1410,card:200};
for(let cat of ['bank','airline','hotel','business']){let a=categories[cat];a.forEach((n,i)=>{let x=spots[cat]+(cat==='airline'&&airlineCols===2?(i%2)*300:0);let ix=cat==='airline'?Math.floor(i/airlineCols):i,rows=cat==='airline'?Math.ceil(a.length/airlineCols):a.length;let y=165+ix*Math.min(cat==='bank'?145:110,(height-270)/Math.max(rows-1,1));positions.set(n.id,{x,y})})}
let maxBank=Math.max(0,...categories.bank.map(n=>positions.get(n.id).y));categories.card.forEach((n,i)=>positions.set(n.id,{x:200+(i%2)*290,y:Math.max(maxBank+150,340)+Math.floor(i/2)*98}));let bottom=Math.max(0,...categories.hotel.map(n=>positions.get(n.id).y));categories.program.forEach((n,i)=>positions.set(n.id,{x:1410,y:bottom+125+i*100}));height=Math.max(height,...[...positions.values()].map(p=>p.y+125));return{height,airlineCols}}
function edgePath(e){let a=positions.get(e.a),b=positions.get(e.b);let same=Math.abs(a.x-b.x)<30;let dir=b.x>=a.x?1:-1;let ax=a.x+dir*122,bx=b.x-dir*122;if(same){ax=a.x+122;bx=b.x+122;let k=90+Math.abs(a.y-b.y)*.13;return`M ${ax} ${a.y} C ${ax+k} ${a.y},${bx+k} ${b.y},${bx} ${b.y}`}let c=Math.max(80,Math.abs(bx-ax)*.42);return`M ${ax} ${a.y} C ${ax+dir*c} ${a.y},${bx-dir*c} ${b.y},${bx} ${b.y}`}
function draw(){let g=getGraph();visibleEdges=g.edges;visibleNodes=g.ns;let lay=layout(g.ns);svg.replaceChildren();let defs=el('defs');for(let t in palette){let m=el('marker',{id:'arrow-'+t,viewBox:'0 0 10 10',refX:9,refY:5,markerWidth:5,markerHeight:5,orient:'auto-start-reverse'});m.append(el('path',{d:'M 0 0 L 10 5 L 0 10 z',fill:palette[t]}));defs.append(m)}svg.append(defs);
let heads=lay.mobile?[[focus?'DIRECT CONNECTIONS · TAP A NODE':'REWARDS NETWORK · TAP TO FOCUS',36]]:[['CARD CURRENCIES / CARDS',75],['AIRLINE PROGRAMS',lay.airlineCols===2?595:755],['HOTELS / OTHER PROGRAMS',1285],['EVERYDAY BUSINESSES',1755]];heads.forEach(([s,x])=>svg.append(el('text',{x,y:65,class:'colhead'},s)));
for(let e of g.edges){let p=el('path',{d:edgePath(e),stroke:palette[e.type],'stroke-width':focus?2.6:1.6,opacity:focus?.8:e.type==='transfer'?.15:.48,class:'edge','marker-end':'url(#arrow-'+e.type+')',...(e.bi?{'marker-start':'url(#arrow-'+e.type+')'}:{}),...(e.type==='benefit'?{'stroke-dasharray':'7 5'}:{})});p.dataset.a=e.a;p.dataset.b=e.b;p.dataset.type=e.type;p.append(el('title',{},`${nodes.get(e.a).name} ${e.bi?'↔':'→'} ${nodes.get(e.b).name} · ${typeNames[e.type]} · ${e.label}`));p.addEventListener('click',()=>showEdge(e));svg.append(p)}
for(let n of g.ns){let p=positions.get(n.id),gr=el('g',{class:'node',transform:`translate(${p.x-124},${p.y-31})`,tabindex:0,role:'button','aria-label':n.name+' '+n.sub});gr.dataset.id=n.id;gr.append(el('rect',{width:248,height:62,rx:10,fill:n.id===focus?'#1c3a35':'#13212d',stroke:n.id===focus?'#88f5ce':catColor[n.cat]+'70','stroke-width':n.id===focus?2:1}));let tx=16;
if(n.logo){gr.append(el('rect',{x:9,y:12,width:38,height:38,rx:7,fill:'#f4f5f4'}));gr.append(el('image',{x:12,y:15,width:32,height:32,href:n.logo,preserveAspectRatio:'xMidYMid meet'}));tx=58}else{gr.append(el('circle',{cx:20,cy:22,r:3,fill:catColor[n.cat]}));tx=31}
let name=n.name.length>25?n.name.slice(0,24)+'…':n.name;gr.append(el('text',{x:tx,y:26,class:'nlabel'},name));let sub=n.sub.length>(n.logo?30:34)?n.sub.slice(0,n.logo?29:33)+'…':n.sub;gr.append(el('text',{x:tx,y:45,class:'nsub'},sub));gr.append(el('title',{},n.name+' · '+n.sub));gr.addEventListener('click',()=>setFocus(n.id));gr.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' ')setFocus(n.id)});gr.addEventListener('mouseenter',()=>highlight(n.id));gr.addEventListener('mouseleave',()=>highlight(''));svg.append(gr)}
if(!g.ns.length)svg.append(el('text',{x:300,y:250,fill:'#aabbcc','font-size':24},'No matching relationships. Clear the search or restore edge types.'));
document.getElementById('counts').textContent=g.ns.length+' nodes / '+g.edges.length+' links shown';fit();if(focus)showNode(focus);else showHome();window.__graphState={nodes:g.ns.length,edges:g.edges.length,view,focus};}
function highlight(id){for(let p of svg.querySelectorAll('.edge'))p.style.opacity=!id?'':p.dataset.a===id||p.dataset.b===id?'1':'.045'}
function showHome(){detail.innerHTML=`<div class="micro">How to explore</div><h2>Follow the currency.</h2><p class="muted">The default view keeps the biggest hubs. Switch to <b>Points transfers</b> for the wider transfer network, or focus any program to see every researched direct connection.</p><div class="note">Arrows matter. A blue earning link is not a green transfer route. You cannot move points backward just because two brands are connected.</div><div class="insight"><h3>Start with a hub</h3>${['chase','bilt','marriott','uber','lyft','rakuten','ba'].map(id=>`<button class="relation" data-focus="${id}"><b>${esc(nodes.get(id).name)}</b><small>${esc(nodes.get(id).sub)}</small></button>`).join('')}</div><p class="muted">Ratios are source points : destination points. Current source terms—not edge count—determine whether a route is useful.</p>`;bindFocusLinks()}
function bindFocusLinks(){detail.querySelectorAll('[data-focus]').forEach(b=>b.onclick=()=>setFocus(b.dataset.focus))}
function showNode(id){let n=nodes.get(id),ee=DATA.edges.filter(e=>enabled.has(e.type)&&(e.a===id||e.b===id));detail.innerHTML=`<div class="micro">${catNames[n.cat]}</div><h2>${esc(n.name)}</h2><p class="muted">${esc(n.sub)}<br>${ee.length} researched connections · click a row for terms.</p>${id==='uber'||id==='lyft'?'<div class="note">Select one linked loyalty earning partner. Payment-card rewards can be a separate layer.</div>':''}${id==='marriott'?'<div class="note">Broad airline reach, usually 3:1. This is not an endorsement of routing bank points through Bonvoy.</div>':''}${id==='bilt'?'<div class="note">Hyatt rate is time-sensitive. The map records the October 21, 2026 snapshot, not a guaranteed future rate.</div>':''}<div id="relrows"></div>`;let list=document.getElementById('relrows');ee.sort((a,b)=>a.type.localeCompare(b.type)||nodes.get(a.a===id?a.b:a.a).name.localeCompare(nodes.get(b.a===id?b.b:b.a).name)).forEach(e=>{let other=nodes.get(e.a===id?e.b:e.a),b=document.createElement('button');b.className='relation';b.innerHTML=`<span class="tag" style="color:${palette[e.type]}">${typeNames[e.type]} · ${e.bi?'↔':e.a===id?'outgoing →':'← incoming'}</span><b>${esc(other.name)}</b><small>${esc(e.label)}</small>`;b.onclick=()=>showEdge(e);list.append(b)})}
function showEdge(e){let a=nodes.get(e.a),b=nodes.get(e.b);detail.innerHTML=`<div class="micro" style="color:${palette[e.type]}">${typeNames[e.type]}</div><h2>${esc(a.name)} ${e.bi?'↔':'→'} ${esc(b.name)}</h2><p style="color:${palette[e.type]};font-size:20px">${esc(e.label)}</p><p>${esc(e.note)}</p><div class="sources"><div class="micro">Evidence · ${e.verifiedAt ? 'rechecked '+esc(e.verifiedAt) : 'original snapshot '+esc(DATA.date)+'; not individually rechecked'}</div>${e.sources.map(id=>{let s=DATA.sources[id];return`<a href="${esc(s.url)}" target="_blank" rel="noopener">${esc(s.title)}${s.primary?'':' [secondary]'}</a>`}).join('')}</div><div class="insight"><button class="relation" data-focus="${e.a}">Explore ${esc(a.name)}</button><button class="relation" data-focus="${e.b}">Explore ${esc(b.name)}</button></div>`;bindFocusLinks();svg.querySelectorAll('.edge').forEach(p=>p.style.opacity=p.dataset.a===e.a&&p.dataset.b===e.b&&p.dataset.type===e.type?'1':'.06')}
function setFocus(id){focus=id;filter='';document.getElementById('search').value='';select.value=id;draw()}
function applyVB(){svg.setAttribute('viewBox',`${vb.x} ${vb.y} ${vb.w} ${vb.h}`)}
function fit(){if(window.matchMedia('(max-width:700px)').matches&&!document.querySelector('.rewards-map').classList.contains('mobile-full')){let h=Math.max(700,...[...positions.values()].map(p=>p.y+100));vb={x:0,y:20,w:640,h:h};svg.style.height=Math.ceil(h*svg.getBoundingClientRect().width/640)+'px';applyVB();return}svg.style.height='';let ys=[...positions.values()].map(p=>p.y);vb={x:30,y:20,w:2030,h:Math.max(1050,...ys.map(y=>y+130))};applyVB()}
function zoom(z){let cx=vb.x+vb.w/2,cy=vb.y+vb.h/2;vb.w*=z;vb.h*=z;vb.x=cx-vb.w/2;vb.y=cy-vb.h/2;applyVB()}
document.getElementById('zin').onclick=()=>zoom(.8);document.getElementById('zout').onclick=()=>zoom(1.25);document.getElementById('fit').onclick=fit;
document.querySelectorAll('[data-view]').forEach(b=>b.onclick=()=>{view=b.dataset.view;focus='';select.value='';filter='';document.getElementById('search').value='';document.querySelectorAll('[data-view]').forEach(x=>x.classList.toggle('active',x===b));draw()});select.onchange=()=>setFocus(select.value);document.getElementById('reset').onclick=()=>setFocus('');document.getElementById('search').oninput=e=>{filter=e.target.value.trim().toLowerCase();focus='';select.value='';draw()};document.querySelectorAll('[data-type]').forEach(c=>c.onchange=()=>{c.checked?enabled.add(c.dataset.type):enabled.delete(c.dataset.type);draw()});document.addEventListener('keydown',e=>{if(e.key==='Escape')setFocus('')});
// Pointer gestures use the SVG's real screen transform, including viewBox letterboxing.
const graphPointers=new Map();let graphGesture=null,lastGraphDrag=0;
function beginGraphGesture(){let ps=[...graphPointers.values()],m=svg.getScreenCTM();if(!ps.length||!m){graphGesture=null;return}let cx=ps.reduce((s,p)=>s+p.x,0)/ps.length,cy=ps.reduce((s,p)=>s+p.y,0)/ps.length;let pt=svg.createSVGPoint();pt.x=cx;pt.y=cy;let anchor=pt.matrixTransform(m.inverse());graphGesture={start:{...vb},cx,cy,scale:m.a,anchor,distance:ps.length>1?Math.hypot(ps[1].x-ps[0].x,ps[1].y-ps[0].y):0,moved:false}}
svg.addEventListener('pointerdown',e=>{if(e.pointerType==='mouse'&&e.button!==0)return;graphPointers.set(e.pointerId,{x:e.clientX,y:e.clientY});beginGraphGesture()});
window.addEventListener('pointermove',e=>{if(!graphPointers.has(e.pointerId)||!graphGesture)return;graphPointers.set(e.pointerId,{x:e.clientX,y:e.clientY});let ps=[...graphPointers.values()],cx=ps.reduce((s,p)=>s+p.x,0)/ps.length,cy=ps.reduce((s,p)=>s+p.y,0)/ps.length,g=graphGesture,dx=cx-g.cx,dy=cy-g.cy;let distance=ps.length>1?Math.hypot(ps[1].x-ps[0].x,ps[1].y-ps[0].y):0;if(!g.moved&&ps.length===1&&Math.hypot(dx,dy)<6)return;g.moved=true;lastGraphDrag=Date.now();e.preventDefault();try{svg.setPointerCapture(e.pointerId)}catch(_){}let f=g.distance>0&&distance>0?g.distance/distance:1;f=Math.min(4,Math.max(.15,f));vb.w=g.start.w*f;vb.h=g.start.h*f;vb.x=g.anchor.x-(g.anchor.x-g.start.x)*f-dx*f/g.scale;vb.y=g.anchor.y-(g.anchor.y-g.start.y)*f-dy*f/g.scale;applyVB()},{passive:false});
function endGraphPointer(e){if(!graphPointers.has(e.pointerId))return;if(graphGesture?.moved)lastGraphDrag=Date.now();graphPointers.delete(e.pointerId);try{svg.releasePointerCapture(e.pointerId)}catch(_){}beginGraphGesture()}
window.addEventListener('pointerup',endGraphPointer);window.addEventListener('pointercancel',endGraphPointer);
svg.addEventListener('click',e=>{if(Date.now()-lastGraphDrag<350){e.preventDefault();e.stopImmediatePropagation()}},true);

document.getElementById('export').onclick=()=>{let clone=svg.cloneNode(true);let style=el('style',{},'.nlabel{font-family:Arial,sans-serif;font-size:16px;font-weight:600;fill:#eef4fa}.nsub{font-family:Arial,sans-serif;font-size:10.8px;fill:#93a9bb}.colhead{font-family:Arial,sans-serif;font-size:12px;font-weight:600;letter-spacing:2.5px;fill:#6e8a9e}');clone.prepend(style);clone.insertBefore(el('rect',{x:vb.x,y:vb.y,width:vb.w,height:vb.h,fill:'#0b1118'}),style);let url=URL.createObjectURL(new Blob([new XMLSerializer().serializeToString(clone)],{type:'image/svg+xml'}));let a=document.createElement('a');a.href=url;a.download='rewards-network-'+(focus||view)+'.svg';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)};
draw();select.value=focus;document.querySelector('.rewards-map').classList.add('enhanced');fit();let graphLastWidth=window.innerWidth;window.addEventListener('resize',()=>{if(window.innerWidth!==graphLastWidth){graphLastWidth=window.innerWidth;draw()}});

// Phone-first explorer: four grouped connections, never dozens of crossing edges.
let mobileGroup='',mobileLimit=5,mobileFull=false;
const phone=()=>window.matchMedia('(max-width:700px)').matches;
const groupFor=n=>n.cat==='bank'||n.cat==='card'?'cards':n.cat==='hotel'?'hotels':n.cat==='business'?'everyday':'travel';
const groupInfo={cards:['Cards & currencies','#5ee6b5'],travel:['Travel programs','#7cb9ff'],hotels:['Hotel programs','#b7a0f6'],everyday:['Everyday partners','#e9c77e']};
const originalDraw=draw;
const mobileRoot=document.createElement('section');mobileRoot.id='mobile-explorer';document.querySelector('.rewards-map .layout').before(mobileRoot);
function mobileMap(id,groups){let n=nodes.get(id),short=n.name.length>24?n.name.slice(0,23)+'…':n.name;let boxes=[['cards',0,0],['travel',270,0],['hotels',0,220],['everyday',270,220]];
let paths=boxes.map(([g,x,y])=>`<path d="M ${x+75} ${y+27} L ${x+75} ${y===0?84:190} L 210 ${y===0?84:190} L 210 137" fill="none" stroke="${groupInfo[g][1]}" stroke-width="1.5" opacity="${groups[g].length?.65:.12}"/>`).join('');
let buttons=boxes.map(([g,x,y])=>`<g role="button" tabindex="0" data-group="${g}" aria-label="${groupInfo[g][0]}, ${groups[g].length} connections"><rect x="${x}" y="${y}" width="150" height="54" rx="12" fill="${mobileGroup===g?'#244039':'#14212e'}" stroke="${mobileGroup===g?groupInfo[g][1]:'#334455'}"/><text x="${x+75}" y="${y+22}" text-anchor="middle" fill="#f0f5fa" font-size="12" font-family="Arial">${groupInfo[g][0]}</text><text x="${x+75}" y="${y+41}" text-anchor="middle" fill="${groupInfo[g][1]}" font-size="11" font-family="Arial">${groups[g].length} connections</text></g>`).join('');
return `<svg class="mobile-hub" viewBox="-8 -12 436 302" role="img" aria-label="${esc(n.name)} connected to four groups">${paths}<rect x="108" y="105" width="204" height="64" rx="15" fill="#1b3832" stroke="#68d5b1"/><text x="210" y="132" text-anchor="middle" fill="#effcf6" font-size="16" font-family="Arial" font-weight="600">${esc(short)}</text><text x="210" y="153" text-anchor="middle" fill="#a1bcb0" font-size="10" font-family="Arial">SELECTED PROGRAM</text>${buttons}</svg>`}
function renderMobile(){if(!phone())return;let id=focus||'chase',n=nodes.get(id),all=DATA.edges.filter(e=>e.a===id||e.b===id),groups={cards:[],travel:[],hotels:[],everyday:[]};all.forEach(e=>groups[groupFor(nodes.get(e.a===id?e.b:e.a))].push(e));if(!mobileGroup||!groups[mobileGroup].length)mobileGroup=Object.keys(groups).sort((a,b)=>groups[b].length-groups[a].length)[0]||'cards';
let list=groups[mobileGroup],color=groupInfo[mobileGroup][1];mobileRoot.innerHTML=`<div class="mobile-mode"><button id="mobile-explore-mode" class="${!mobileFull?'active':''}">Explore a program</button><button id="mobile-full-mode" class="${mobileFull?'active':''}">Full network</button></div><div class="mobile-controls"><label for="mobile-program">Choose a program</label><select id="mobile-program">${DATA.nodes.slice().sort((a,b)=>a.name.localeCompare(b.name)).map(x=>`<option value="${x.id}" ${x.id===id?'selected':''}>${esc(x.name)} · ${esc(x.sub)}</option>`).join('')}</select></div><div class="mobile-focused"><span>${all.length} direct relationships · tap a group</span>${mobileMap(id,groups)}</div><div class="mobile-list-title"><h2>${groupInfo[mobileGroup][0]}</h2><span style="color:${color}">${list.length}</span></div><div class="mobile-relationships">${list.slice(0,mobileLimit).map((e,i)=>{let other=nodes.get(e.a===id?e.b:e.a),from=nodes.get(e.a),to=nodes.get(e.b);return `<article class="mobile-relation" style="--edge-color:${palette[e.type]}"><div class="mobile-row-top">${other.logo?`<img src="${other.logo}" alt=""/>`:'<span class="mobile-brand-dot"></span>'}<button class="mobile-other" data-go="${other.id}">${esc(other.name)} <span>Explore →</span></button></div><div class="mobile-direction">${esc(from.name)} ${e.bi?'↔':'→'} ${esc(to.name)}</div><div class="mobile-tags"><span>${typeNames[e.type]}</span><b>${esc(e.label)}</b></div><details class="mobile-terms"><summary>Terms & sources</summary><p>${esc(e.note)}</p><p class="muted">${e.verifiedAt ? 'Rechecked '+esc(e.verifiedAt) : 'Original snapshot '+esc(DATA.date)+' · not individually rechecked'}</p>${e.sources.map(k=>`<a href="${esc(DATA.sources[k].url)}" target="_blank" rel="noopener">${esc(DATA.sources[k].title)} ↗</a>`).join('')}</details></article>`}).join('')||'<p class="muted">No researched relationships in this group.</p>'}</div>${list.length>mobileLimit?`<button id="mobile-more">Show ${list.length-mobileLimit} more connections</button>`:''}<p class="mobile-explainer">Arrows show direction. Transfers, earning, and card benefits are different relationships. Open a row’s terms for eligibility and evidence.</p>`;
mobileRoot.querySelector('#mobile-program').onchange=e=>{focus=e.target.value;mobileGroup='';mobileLimit=5;select.value=focus;renderMobile()};mobileRoot.querySelectorAll('[data-group]').forEach(b=>{let selectGroup=()=>{mobileGroup=b.dataset.group;mobileLimit=5;renderMobile()};b.onclick=selectGroup;b.onkeydown=e=>{if(e.key==='Enter')selectGroup()}});mobileRoot.querySelectorAll('[data-go]').forEach(b=>b.onclick=()=>{focus=b.dataset.go;mobileGroup='';mobileLimit=5;renderMobile();mobileRoot.scrollIntoView({behavior:'smooth',block:'start'})});let more=mobileRoot.querySelector('#mobile-more');if(more)more.onclick=()=>{mobileLimit=list.length;renderMobile()};mobileRoot.querySelector('#mobile-full-mode').onclick=()=>{mobileFull=true;view='all';focus='';select.value='';document.querySelector('.rewards-map').classList.add('mobile-full');originalDraw();renderMobile()};mobileRoot.querySelector('#mobile-explore-mode').onclick=()=>{mobileFull=false;document.querySelector('.rewards-map').classList.remove('mobile-full');renderMobile()};}
draw=function(){originalDraw();renderMobile()};
renderMobile();window.addEventListener('resize',renderMobile);

</script>
