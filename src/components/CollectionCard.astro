---
import type { PhotoCollection } from '../lib/photos';
import Photo from './Photo.astro';

interface Props {
    collection: PhotoCollection;
    showTag?: boolean;
}

const { collection, showTag = true } = Astro.props;
const { id, data, cover, dateLabel, photos } = collection;
const noun = data.tags.includes('Published') ? 'spread' : data.tags.includes('Film') ? 'frame' : 'photo';
const count = `${photos.length} ${noun}${photos.length === 1 ? '' : 's'}`;
---

<a class="card" href={`/photos/${id}/`} data-tags={data.tags.join(',')}>
    <span class="frame">
        <Photo photo={cover} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 400px" widths={[400, 800, 1200]} />
    </span>
    <span class="row">
        <span class="title">{data.title}</span>
        {showTag && <span class="eyebrow">{data.tags[0]}</span>}
    </span>
    <span class="eyebrow">{[dateLabel, data.place, count].filter(Boolean).join(' · ')}</span>
</a>

<style>
    .card {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .card[hidden] {
        display: none;
    }
    .frame {
        display: block;
        aspect-ratio: 4 / 3;
        overflow: hidden;
        background: var(--bg-hi);
    }
    .frame :global(picture),
    .frame :global(img) {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: opacity 500ms var(--ease), transform 600ms var(--ease-out), filter 400ms var(--ease);
    }
    .card:hover .frame :global(img) {
        transform: scale(1.03);
        filter: brightness(0.92);
    }
    .row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 12px;
    }
    .title {
        font-size: 18px;
        font-weight: 400;
    }
</style>
