---
import { Picture } from 'astro:assets';
import { isCloudinary, remoteAt, type Photo } from '../lib/photos';

// Local photos go through Astro's image pipeline (AVIF/WebP at several widths).
// Cloudinary ones get the same widths from URL transforms; other remote ones pass through.
interface Props {
    photo: Photo;
    sizes: string;
    widths?: number[];
    loading?: 'lazy' | 'eager';
    priority?: boolean;
}

const { photo, sizes, widths = [480, 800, 1200, 1600, 2048], loading = 'lazy', priority = false } = Astro.props;
const fetchpriority = priority ? 'high' : undefined;
const src = photo.src;
const srcset = typeof src === 'string' && isCloudinary(src) ? widths.map((w) => `${remoteAt(src, w)} ${w}w`).join(', ') : undefined;
---

{
    typeof photo.src === 'string' ? (
        <img
            src={photo.src}
            srcset={srcset}
            sizes={srcset && sizes}
            alt={photo.alt}
            loading={loading}
            decoding="async"
            fetchpriority={fetchpriority}
        />
    ) : (
        <Picture
            src={photo.src}
            alt={photo.alt}
            widths={widths.filter((w) => typeof photo.src !== 'string' && w <= photo.src.width)}
            sizes={sizes}
            formats={['avif', 'webp']}
            loading={loading}
            decoding="async"
            fetchpriority={fetchpriority}
        />
    )
}
