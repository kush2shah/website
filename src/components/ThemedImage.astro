---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

// An image with an optional dark-mode variant, swapped by the browser via <picture>.
// `width` is the rendered CSS width; a 2x version is generated for sharp screens.
interface Props {
    light: ImageMetadata;
    dark?: ImageMetadata;
    alt: string;
    width: number;
    loading?: 'lazy' | 'eager';
}

const { light, dark, alt, width, loading = 'lazy' } = Astro.props;

async function render(img: ImageMetadata) {
    if (img.format === 'svg') return img.src;
    const out = await getImage({ src: img, width: Math.min(width * 2, img.width), format: 'webp' });
    return out.src;
}

const lightSrc = await render(light);
const darkSrc = dark ? await render(dark) : undefined;
const height = Math.round((width * light.height) / light.width);
---

<picture>
    {darkSrc && <source media="(prefers-color-scheme: dark)" srcset={darkSrc} />}
    <img src={lightSrc} alt={alt} width={width} height={height} loading={loading} decoding="async" />
</picture>
